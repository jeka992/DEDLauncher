<Window x:Class="DedLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:DedLauncher.Models"
        xmlns:vm="clr-namespace:DedLauncher.ViewModels"
        xmlns:cnv="clr-namespace:DedLauncher.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DED Launcher"
        Icon="Assets/icon.ico"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="10"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <cnv:InvertBoolConverter x:Key="InvBool"/>
        <cnv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <cnv:SubtractConverter x:Key="Sub"/>

        <!-- Nav button: no default hover chrome, fully rounded -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window control button: compact, subtle rounded hover -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F3F3F46"/>
                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button: subtle red hover -->
        <Style x:Key="WinBtnClose" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4DB30000"/>
                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле поиска со значком лупы -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="34,0,12,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Path x:Name="icon" Data="M21 21l-4.35 -4.35 M17 10a7 7 0 1 0 -14 0a7 7 0 0 0 14 0"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{StaticResource TextFaintBrush}" StrokeThickness="1.8"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка поиска -->
        <Style x:Key="SearchBtn" TargetType="Button" BasedOn="{StaticResource BtnRed}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <!-- ROOT -->
    <Border x:Name="RootBorder" Background="{StaticResource BgDeepBrush}"
            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
        <Grid AllowDrop="True"
              DragEnter="Window_DragEnter" DragOver="Window_DragOver"
              DragLeave="Window_DragLeave" Drop="Window_Drop">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="72" MinWidth="72" MaxWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== LEFT SIDEBAR ========== -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo (compass): клик — на главную, hover rotate 45 -->
                    <Button x:Name="BtnLogo" Grid.Row="0" Width="46" Height="46" Margin="13,18,13,20"
                            Cursor="Hand" BorderThickness="0" Padding="0"
                            Background="{DynamicResource BgCardBrush}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.BetweenShowDelay="0"
                            ToolTipService.ShowDuration="5000"
                            ToolTip="Главная"
                            Click="Logo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="46" Height="46" CornerRadius="10"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#4452525B" BorderThickness="1">
                                    <Grid x:Name="logoGrid" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="logoRotate" Angle="0"/>
                                        </Grid.RenderTransform>
                                        <Image x:Name="BtnLogoImage" Width="36" Height="36"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="logoRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     To="45" Duration="0:0:0.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="logoRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     To="0" Duration="0:0:0.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Nav: Play, Mods, Console -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <Button x:Name="BtnPlay" Click="Nav_Click" Tag="play" Margin="7,2"
                                Style="{StaticResource NavBtn}" Width="58" Height="58">
                            <StackPanel>
                                <TextBlock Text="▶" FontSize="18" HorizontalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="ЗАПУСК" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnMods" Click="Nav_Click" Tag="mods" Margin="7,2"
                                Style="{StaticResource NavBtn}" Width="58" Height="58">
                            <StackPanel>
                                <TextBlock Text="◆" FontSize="18" HorizontalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="МОДЫ" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnConsole" Click="Nav_Click" Tag="console" Margin="7,2"
                                Style="{StaticResource NavBtn}" Width="58" Height="58">
                            <StackPanel>
                                <TextBlock Text="☰" FontSize="18" HorizontalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="КОНСОЛЬ" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnScreenshots" Click="Nav_Click" Tag="screenshots" Margin="7,2"
                                Style="{StaticResource NavBtn}" Width="58" Height="58">
                            <StackPanel>
                                <TextBlock Text="📷" FontSize="16" HorizontalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                <TextBlock Text="ФОТО" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFriends" Click="Nav_Click" Tag="friends" Margin="7,2"
                                Style="{StaticResource NavBtn}" Width="58" Height="58">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    <TextBlock Text="ДРУЗЬЯ" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                </StackPanel>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="5,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding TotalUnread}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Setup at bottom -->
                    <Button x:Name="BtnSetup" Grid.Row="2" Click="Nav_Click" Tag="setup" Margin="7,2,7,10"
                            Style="{StaticResource NavBtn}" Width="58" Height="58">
                        <StackPanel>
                            <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            <TextBlock Text="SETUP" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Resize handle -->
            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                          HorizontalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Разделитель: тянет ширину сайдбара -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle x:Name="grip" Width="2" Fill="{StaticResource BorderBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Width" Value="3"/>
                                <Setter TargetName="grip" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ========== MAIN ========== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BgHeaderBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.3" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="DED Launcher" FontSize="15" FontWeight="Black" Foreground="White"/>
                            <Border Background="{StaticResource BgHoverBrush}" CornerRadius="12" Padding="8,3" Margin="10,0,0,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDimBrush}">
                                    <Run Text="{Binding VersionLabel, StringFormat=v{0}, Mode=OneWay}"/>
                                    <Run Text="{Binding CurrentProfile.ShortInfo, StringFormat= · {0}, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- User: аккаунт-чип, все манипуляции через попап -->
                        <ToggleButton x:Name="BtnAccountChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                      Background="{StaticResource BgCardBrush}" Cursor="Hand" Padding="6,5"
                                      Margin="0,0,140,0" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BgHoverBrush}"
                                                    ClipToBounds="True" Margin="0,0,6,0">
                                                <Image Source="{Binding ChipAvatar}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                <Border.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="26" Height="26" CornerRadius="13" Background="White"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Border.OpacityMask>
                                            </Border>
                                            <TextBlock Text="{Binding ChipName}" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding ChipTypeLabel}" FontSize="10"
                                                       Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource TextFaintBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Попап управления аккаунтами -->
                        <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=BtnAccountChip}"
                               Placement="Bottom" HorizontalOffset="-110" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsChecked, ElementName=BtnAccountChip, Mode=TwoWay}">
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="12" Width="264"
                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.8" To="1" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.45" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Discord: авторизация лаунчера -->
                                    <StackPanel Visibility="{Binding HasDiscordProfile, Converter={StaticResource InvBoolVis}}">
                                        <TextBlock Text="ПРОФИЛЬ ЛАУНЧЕРА" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                        <Button Content="Войти через Discord" FontSize="11" Padding="12,7"
                                                Command="{Binding LoginDiscordCmd}"
                                                IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvBool}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#5865F2"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Text="Не обязательно — только для профиля лаунчера" FontSize="8"
                                                   Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasDiscordProfile, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="ПРОФИЛЬ ЛАУНЧЕРА" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource BgHoverBrush}"
                                                    ClipToBounds="True" Margin="0,0,8,0">
                                                <Image Source="{Binding AccountAvatar}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="24" Height="24" CornerRadius="12" Background="White"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Border.OpacityMask>
                                            </Border>
                                            <TextBlock Text="{Binding DiscordProfile.Username}" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="Выйти из Discord" Style="{StaticResource BtnOutline}"
                                                FontSize="10" Padding="10,5" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Click="LogoutDiscord_Click"/>
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10"/>

                                    <TextBlock Text="ВХОД В MINECRAFT" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                    <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                             Background="Transparent" BorderThickness="0" MaxHeight="160"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,2"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                    CornerRadius="6" Padding="8,6">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#33B30000"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Username}" FontSize="12" FontWeight="Bold"/>
                                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding AccountTypeLabel}" FontSize="8" Foreground="{StaticResource TextDimBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource IconBtn}"
                                                            Width="20" Height="20" FontSize="9"
                                                            Click="RemoveAccountFromPopup_Click" Tag="{Binding}"
                                                            ToolTip="Удалить аккаунт"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
                                    <Button Content="Войти онлайн" Style="{StaticResource BtnRed}"
                                            FontSize="11" Padding="12,7" Margin="0,0,0,6"
                                            Command="{Binding LoginMsCmd}"
                                            IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvBool}}"/>
                                    <TextBox Text="{Binding OfflineUsername, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Height="30" Padding="8,0" Margin="0,0,0,6"/>
                                    <Button Content="Войти оффлайн" Style="{StaticResource BtnRed}"
                                            FontSize="11" Padding="12,7"
                                            Command="{Binding LoginOfflineCmd}"/>
                                    <TextBlock Text="{Binding AccountStatus}" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Window controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="─" Style="{StaticResource WinBtn}" Click="Minimize_Click"/>
                            <Button Content="□" Style="{StaticResource WinBtn}" Click="Maximize_Click"/>
                            <Button Content="✕" Style="{StaticResource WinBtnClose}" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pages -->
                <Grid x:Name="PagesHost" Grid.Row="1">
                    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsHomePage, Converter={StaticResource BoolVis}}">
                        <Grid Margin="24,16,24,24">

                        <!-- ===== HOME ===== -->
                        <Grid Visibility="{Binding HomeActive, Converter={StaticResource BoolVis}}">
                            <StackPanel>

                                <!-- Hero -->
                                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10"
                                        BorderBrush="{StaticResource BorderLightBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding CurrentProfile.ModLoader, TargetNullValue=VANILLA}"
                                                               FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="ГОТОВО К ЗАПУСКУ" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding CurrentProfile.VersionId}" FontSize="28" FontWeight="Black"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock Text="Minecraft" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                                       Margin="0,0,0,8"/>

                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BgHoverBrush}"
                                                        ClipToBounds="True" Margin="0,0,8,0">
                                                    <Image Source="{Binding SkinHeadPreview}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding Account.Username}" FontSize="13" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <Border Background="{StaticResource BgHoverBrush}" CornerRadius="10" Padding="8,3"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}">
                                                        <Run Text="{Binding CurrentProfile.MaxRamMb, Mode=OneWay}"/><Run Text=" МБ RAM"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <Button Content="▶  ИГРАТЬ" Style="{StaticResource BtnRed}"
                                                    Command="{Binding LaunchCmd}"
                                                    Width="180" Height="50" FontSize="18"/>
                                            <Button Content="⏹  ОСТАНОВИТЬ" Style="{StaticResource BtnOutline}"
                                                    Command="{Binding StopCmd}" Width="180" Height="32" Margin="0,6,0,0"
                                                    FontSize="11"
                                                    Visibility="{Binding IsGameRunning, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Info cards -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Build -->
                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="СБОРКА" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding CurrentProfile.DisplayVersion}" FontSize="14" FontWeight="Bold"
                                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}">
                                                <Run Text="Окно: "/><Run Text="{Binding CurrentProfile.WindowWidth, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding CurrentProfile.WindowHeight, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mods -->
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="МОДЫ" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                            <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,4">
                                                <Run Text="{Binding ModsCount, Mode=OneWay}"/><Run Text=" установлено"/>
                                            </TextBlock>
                                            <Button Content="Открыть моды →" Style="{StaticResource BtnOutline}"
                                                    Command="{Binding NavModsCmd}" FontSize="11" Padding="10,5"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

<!-- Stats -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="СТАТИСТИКА ИГРЫ" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TodayTimeLabel}" FontSize="22" FontWeight="Black"/>
                                                <TextBlock Text="сегодня" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalTimeLabel}" FontSize="22" FontWeight="Black"/>
                                                <TextBlock Text="всего" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Grid>

                                <!-- History -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="ИСТОРИЯ ЗАПУСКОВ" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnHistoryToggle" Content="▾" Style="{StaticResource IconBtn}"
                                                    HorizontalAlignment="Right" Width="22" Height="22" FontSize="10"
                                                    Click="HistoryToggle_Click" ToolTip="Свернуть / развернуть"/>
                                        </Grid>
                                        <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                            <ItemsControl ItemsSource="{Binding LaunchHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6"
                                                                Padding="10,7" Margin="0,2">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Version}" FontSize="11" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Time, StringFormat='dd.MM HH:mm'}" FontSize="10"
                                                                           Foreground="{StaticResource TextFaintBrush}"
                                                                           HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== PLAY ===== -->
                    <Grid Margin="24,16,24,24" Visibility="{Binding PlayActive, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Запуск Игры" FontSize="20" FontWeight="Black" Margin="0,0,0,4"/>
                                <TextBlock Text="Настройте профиль и запустите игру." FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14"/>

                                <!-- Profile selector -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="ПРОФИЛЬ" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CurrentProfile}"
                                                  DisplayMemberPath="Name" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding CurrentProfile.DisplayVersion}" FontSize="12"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Version selector (Vanilla / Fabric / Forge) -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="ВЕРСИЯ" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="BtnVersionPick" Grid.Column="0" HorizontalAlignment="Stretch"
                                                          Height="38" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="bd" Background="{StaticResource BgInputBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                CornerRadius="8" Padding="12,0">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding SelectedVersionOption.McVersion}"
                                                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}"/>
                                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4"
                                                                            Padding="6,1" Margin="8,0,0,0"
                                                                            Visibility="{Binding SelectedVersionOption.IsSnapshot, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="Снапшот" FontSize="8" Foreground="White"/>
                                                                    </Border>
                                                                    <Border Background="#4A5A72" CornerRadius="4" Padding="6,1"
                                                                            Margin="8,0,0,0"
                                                                            Visibility="{Binding SelectedVersionOption.IsOld, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{Binding SelectedVersionOption.TypeLabel}" FontSize="8" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="▾" FontSize="9" Foreground="{StaticResource TextFaintBrush}"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding LoaderChoices}"
                                                      SelectedItem="{Binding SelectedLoader}"
                                                      Width="110" FontSize="12" FontWeight="Bold"/>

                                            <!-- Попап выбора версии -->
                                            <Popup x:Name="VersionPopup" PlacementTarget="{Binding ElementName=BtnVersionPick}"
                                                   Placement="Bottom" HorizontalOffset="-20" StaysOpen="False"
                                                   AllowsTransparency="True" PopupAnimation="Fade"
                                                   IsOpen="{Binding IsChecked, ElementName=BtnVersionPick, Mode=TwoWay}">
                                                <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="12" Width="340"
                                                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.45" Color="#000000"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock Text="ВЫБЕРИТЕ ВЕРСИЮ" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                                        <TextBox Text="{Binding VersionFilter, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="12" Height="32" Margin="0,0,0,8"
                                                                 ToolTip="Поиск версии..."/>
                                                        <WrapPanel Margin="0,0,0,8">
                                                            <Button x:Name="BtnVcAll" Content="Все" Click="VersionCategory_Click" Tag="0"
                                                                    Style="{StaticResource BtnOutline}" FontSize="10" Padding="10,4" Margin="0,0,6,4"/>
                                                            <Button x:Name="BtnVcReleases" Content="Релизы" Click="VersionCategory_Click" Tag="1"
                                                                    Style="{StaticResource BtnOutline}" FontSize="10" Padding="10,4" Margin="0,0,6,4"/>
                                                            <Button x:Name="BtnVcSnapshots" Content="Снапшоты" Click="VersionCategory_Click" Tag="2"
                                                                    Style="{StaticResource BtnOutline}" FontSize="10" Padding="10,4" Margin="0,0,6,4"/>
                                                            <Button x:Name="BtnVcOld" Content="Старые" Click="VersionCategory_Click" Tag="3"
                                                                    Style="{StaticResource BtnOutline}" FontSize="10" Padding="10,4"/>
                                                        </WrapPanel>
                                                        <ListBox ItemsSource="{Binding VersionOptions}"
                                                                 SelectedItem="{Binding SelectedVersionOption}"
                                                                 Background="Transparent" BorderThickness="0" Height="300"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="Margin" Value="0,1"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                                        CornerRadius="6" Padding="10,6">
                                                                                    <ContentPresenter/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#33B30000"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding McVersion}" FontSize="12"
                                                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="4"
                                                                                Padding="6,1" Visibility="{Binding IsSnapshot, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="Снапшот" FontSize="8" Foreground="White"/>
                                                                        </Border>
                                                                        <Border Grid.Column="1" Background="#4A5A72" CornerRadius="4"
                                                                                Padding="6,1" Visibility="{Binding IsOld, Converter={StaticResource BoolVis}}">
                                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="8" Foreground="White"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <TextBlock Text="Загрузчик: Vanilla / Fabric / Forge" FontSize="10"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- RAM -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="ВЫДЕЛЕНИЕ ПАМЯТИ" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Выделено:" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock FontSize="12" FontWeight="Bold" Margin="4,0,0,0">
                                                <Run Text="{Binding CurrentProfile.MaxRamMb, Mode=OneWay}"/><Run Text=" МБ"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextFaintBrush}" Margin="8,1,0,0">
                                                <Run Text="· макс "/><Run Text="{Binding MaxRamLimitMb, Mode=OneWay}"/><Run Text=" МБ"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Slider Minimum="{Binding RamSliderMin}" Maximum="{Binding MaxRamLimitMb}"
                                                Value="{Binding RamSliderValue, Mode=TwoWay}" TickFrequency="512"
                                                IsSnapToTickEnabled="True" Margin="0,4,0,6"/>
                                        <TextBlock Text="{Binding RamInfo}" FontSize="9"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,4"/>
                                        <Button Content="Применить рекомендуемое" Style="{StaticResource BtnOutline}"
                                                FontSize="10" Padding="8,4" HorizontalAlignment="Left"
                                                Click="ApplyRecommendedRam_Click"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="На весь экран" IsChecked="{Binding CurrentProfile.Fullscreen}"
                                                      FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Окно:" FontSize="10" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Text="{Binding CurrentProfile.WindowWidth, UpdateSourceTrigger=PropertyChanged}" Width="52" FontSize="10"/>
                                                <TextBlock Text="×" FontSize="10" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="3,0"/>
                                                <TextBox Text="{Binding CurrentProfile.WindowHeight, UpdateSourceTrigger=PropertyChanged}" Width="52" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Правая колонка: запуск + история -->
                            <StackPanel Grid.Column="2">
                                <Button Content="▶ ЗАПУСТИТЬ ИГРУ" Style="{StaticResource BtnRed}"
                                        Command="{Binding LaunchCmd}" HorizontalAlignment="Stretch" Height="48" FontSize="16"/>
                                <Button Content="⏹ ОСТАНОВИТЬ" Style="{StaticResource BtnOutline}"
                                        Command="{Binding StopCmd}" HorizontalAlignment="Stretch" Height="36" Margin="0,6,0,0"
                                        Visibility="{Binding IsGameRunning, Converter={StaticResource BoolVis}}"/>

                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ИСТОРИЯ ЗАПУСКОВ" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,6"/>
                                        <ListBox ItemsSource="{Binding LaunchHistory}" Background="Transparent" BorderThickness="0"
                                                 MaxHeight="300" FontSize="10">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Text="{Binding Version}" FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Time, StringFormat='dd.MM HH:mm'}" FontSize="8"
                                                                   Foreground="{StaticResource TextFaintBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ===== MODS ===== -->
                        <Grid Margin="24,16,24,24" Visibility="{Binding ModsActive, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Библиотека Модификаций" FontSize="20" FontWeight="Black" Margin="0,0,0,2"/>
                                        <TextBlock Text="Скачивайте моды напрямую из Modrinth."
                                                   FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding OptimizationButtonText}"
                                                FontSize="11" Padding="12,6" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Click="ToggleOptimization_Click"
                                                ToolTip="Поставить или убрать Sodium, Lithium, FerriteCore"
                                                IsEnabled="{Binding Optimizing, Converter={StaticResource InvBool}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OptimizationInstalled}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="📂 Открыть папку mods"
                                                Style="{StaticResource BtnOutline}" FontSize="11" Padding="12,6"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Command="{Binding OpenModsFolderCmd}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Sub-tabs: Моды / Ресурспаки / Шейдеры / Сервера -->
                                <Border Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                                    <WrapPanel>
                                        <Button x:Name="TabModsSub" Click="SubTabMods_Click"
                                                FontSize="11" Padding="12,7" Margin="0,0,4,0">
