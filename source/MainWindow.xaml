                                                <Button Content="Обновить" Style="{StaticResource BtnOutline}" FontSize="10" Padding="8,4"
                                                        Margin="10,0,0,0" Click="RefreshInstalledRps_Click"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding InstalledResourcePacks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type m:InstalledPackItem}">
                                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="8,6" Margin="0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Bold"/>
                                                                    <TextBlock FontSize="9" Foreground="{StaticResource TextFaintBrush}">
                                                                        <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Description, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="✕" Style="{StaticResource IconBtn}"
                                                                        Width="22" Height="22" FontSize="10" VerticalAlignment="Center"
                                                                        Click="RemoveInstalledRp_Click" Tag="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- SUB-TAB: ШЕЙДЕРЫ -->
                                <StackPanel Visibility="{Binding IsShadersSubTab, Converter={StaticResource BoolVis}}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Button x:Name="BtnShaderSrcModrinth" Content="Modrinth" Click="ShaderSourceModrinth_Click"
                                                    FontSize="10" Padding="8,4" Margin="0,0,4,0"/>
                                            <Button x:Name="BtnShaderSrcCurse" Content="CurseForge" Click="ShaderSourceCurseForge_Click"
                                                    FontSize="10" Padding="8,4" Margin="0,0,8,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button x:Name="BtnShaderBrowserV" Content="Браузер" Click="ShaderViewToggle_Click" Tag="browser"
                                                    FontSize="10" Padding="8,4" Margin="0,0,4,0"/>
                                            <Button x:Name="BtnShaderInstalledV" Content="Установленные" Click="ShaderViewToggle_Click" Tag="installed"
                                                    FontSize="10" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Visibility="{Binding IsShaderBrowserView, Converter={StaticResource BoolVis}}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource SearchTextBox}"
                                                     Text="{Binding ModSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="ModSearch_KeyDown"/>
                                            <Button Grid.Column="1" Style="{StaticResource SearchBtn}"
                                                    Click="SearchShaders_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M21 21l-4.35 -4.35 M17 10a7 7 0 1 0 -14 0a7 7 0 0 0 14 0"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Найти" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      MaxHeight="{Binding ActualHeight, ElementName=PagesHost, Converter={StaticResource Sub}, ConverterParameter=235}"
                                                      ScrollChanged="ShadersScroll_ScrollChanged"
                                                      Visibility="{Binding IsShaderModrinth, Converter={StaticResource BoolVis}}">
                                            <ItemsControl ItemsSource="{Binding ShaderResults}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type m:ModrinthMod}">
                                                        <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="10">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0">
                                                                        <Border CornerRadius="6" Background="{DynamicResource AccentBrush}">
                                                                            <TextBlock Text="{Binding Title, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis" MaxWidth="24"/>
                                                                        </Border>
                                                                        <Border CornerRadius="6" Background="{StaticResource BgCardBrush}">
                                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <Border.OpacityMask>
                                                                                <VisualBrush>
                                                                                    <VisualBrush.Visual>
                                                                                        <Border Width="32" Height="32" CornerRadius="6" Background="White"/>
                                                                                    </VisualBrush.Visual>
                                                                                </VisualBrush>
                                                                            </Border.OpacityMask>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="2" Content="↗" Style="{StaticResource IconBtn}"
                                                                            Width="22" Height="22" FontSize="11" Margin="4,0,0,0"
                                                                            Click="OpenShaderPage_Click" Tag="{Binding}"
                                                                            ToolTip="Открыть страницу шейдера"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                                           Foreground="{StaticResource TextFaintBrush}"
                                                                           TextTrimming="CharacterEllipsis" MaxHeight="26" Margin="0,0,0,6"/>
                                                                <Button Content="Скачать" Style="{StaticResource BtnRed}"
                                                                        FontSize="10" Padding="6,4" Height="26"
                                                                        Click="InstallShader_Click" Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      MaxHeight="{Binding ActualHeight, ElementName=PagesHost, Converter={StaticResource Sub}, ConverterParameter=235}"
                                                      ScrollChanged="ShadersCfScroll_ScrollChanged"
                                                      Visibility="{Binding IsShaderCurseForge, Converter={StaticResource BoolVis}}">
                                            <ItemsControl ItemsSource="{Binding ShaderCfResults}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type m:CurseForgeMod}">
                                                        <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="10">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0">
                                                                        <Border CornerRadius="6" Background="{DynamicResource AccentBrush}">
                                                                            <TextBlock Text="{Binding Name, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis" MaxWidth="24"/>
                                                                        </Border>
                                                                        <Border CornerRadius="6" Background="{StaticResource BgCardBrush}">
                                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <Border.OpacityMask>
                                                                                <VisualBrush>
                                                                                    <VisualBrush.Visual>
                                                                                        <Border Width="32" Height="32" CornerRadius="6" Background="White"/>
                                                                                    </VisualBrush.Visual>
                                                                                </VisualBrush>
                                                                            </Border.OpacityMask>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="2" Content="↗" Style="{StaticResource IconBtn}"
                                                                            Width="22" Height="22" FontSize="11" Margin="4,0,0,0"
                                                                            Click="OpenShaderPage_Click" Tag="{Binding}"
                                                                            ToolTip="Открыть страницу шейдера"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Summary}" FontSize="10"
                                                                           Foreground="{StaticResource TextFaintBrush}"
                                                                           TextTrimming="CharacterEllipsis" MaxHeight="26" Margin="0,0,0,6"/>
                                                                <Button Content="Скачать" Style="{StaticResource BtnRed}"
                                                                        FontSize="10" Padding="6,4" Height="26"
                                                                        Click="InstallCurseForgeShader_Click" Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <!-- Установленные шейдеры -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="{Binding ActualHeight, ElementName=PagesHost, Converter={StaticResource Sub}, ConverterParameter=190}"
                                                  Visibility="{Binding IsShaderInstalledView, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Установленные шейдеры" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="Обновить" Style="{StaticResource BtnOutline}" FontSize="10" Padding="8,4"
                                                        Margin="10,0,0,0" Click="RefreshInstalledShaders_Click"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding InstalledShaders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type m:InstalledPackItem}">
                                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="8,6" Margin="0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Bold"/>
                                                                    <TextBlock Text="{Binding SizeText}" FontSize="9" Foreground="{StaticResource TextFaintBrush}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="✕" Style="{StaticResource IconBtn}"
                                                                        Width="22" Height="22" FontSize="10" VerticalAlignment="Center"
                                                                        Click="RemoveInstalledShader_Click" Tag="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- SUB-TAB: СЕРВЕРА -->
                                <StackPanel Visibility="{Binding IsServersSubTab, Converter={StaticResource BoolVis}}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TextBoxServerInput"
                                                 Text="{Binding ServerInput, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Padding="10,8"
                                                 KeyDown="ServerInput_KeyDown"
                                                 ToolTip="Адрес сервера, например play.example.com или 192.168.1.5:25566"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Добавить" Style="{StaticResource BtnRed}"
                                                    FontSize="11" Padding="14,0" Click="AddServer_Click"/>
                                            <Button Content="Обновить пинг" Style="{StaticResource BtnOutline}"
                                                    FontSize="10" Padding="10,0" Margin="8,0,0,0"
                                                    Click="RefreshServers_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="{Binding ActualHeight, ElementName=PagesHost, Converter={StaticResource Sub}, ConverterParameter=210}">
                                        <ItemsControl ItemsSource="{Binding ServersList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ServerEntry}">
                                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <Border CornerRadius="8" Background="{DynamicResource AccentBrush}">
                                                                    <TextBlock Text="{Binding Name, StringFormat={}{0}}" FontSize="15" FontWeight="Bold"
                                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="28"/>
                                                                </Border>
                                                                <Border CornerRadius="8" Background="{StaticResource BgCardBrush}">
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <Border.OpacityMask>
                                                                        <VisualBrush>
                                                                            <VisualBrush.Visual>
                                                                                <Border Width="36" Height="36" CornerRadius="8" Background="White"/>
                                                                            </VisualBrush.Visual>
                                                                        </VisualBrush>
                                                                    </Border.OpacityMask>
                                                                </Border>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Black"/>
                                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Online}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextDimBrush}"/>
                                                                    <TextBlock Text="{Binding AddressLabel}" FontSize="10" Foreground="{StaticResource TextFaintBrush}"
                                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontSize="10" Foreground="{StaticResource TextFaintBrush}">
                                                                    <Run Text="Пинг: "/><Run Text="{Binding Ping}"/><Run Text="ms"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                                <Button Content="✕" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="10"
                                                                        Margin="0,0,6,0" Click="RemoveServer_Click" Tag="{Binding}"
                                                                        ToolTip="Удалить из списка"/>
                                                                <Button Content="Играть" Style="{StaticResource BtnRed}"
                                                                        FontSize="11" FontWeight="Bold" Padding="14,8"
                                                                        Click="JoinServer_Click" Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>

                            <!-- Правая панель: зависит от под-вкладки -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                <!-- Моды: локальная сборка -->
                                <StackPanel Visibility="{Binding IsModsSubTab, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="ЛОКАЛЬНАЯ СБОРКА" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding CurrentProfile.DisplayVersion}" FontSize="12" FontWeight="Black" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8">
                                        <Run Text="Модов: "/><Run Text="{Binding ModsCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="{Binding ActualHeight, ElementName=PagesHost, Converter={StaticResource Sub}, ConverterParameter=150}">
                                        <ItemsControl ItemsSource="{Binding InstalledMods}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:ModInfo}">
                                                    <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                      Click="ModEnabled_Click" ToolTip="Включить/отключить мод"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Version}" FontSize="8" Foreground="{StaticResource TextFaintBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource IconBtn}"
                                                                    Width="20" Height="20" FontSize="9"
                                                                    Click="RemoveModBtn_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Ресурспаки: установленные -->
                                <StackPanel Visibility="{Binding IsResourcePacksSubTab, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="УСТАНОВЛЕННЫЕ РЕСУРСПАКИ" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8">
                                        <Run Text="Всего: "/><Run Text="{Binding InstalledResourcePacks.Count, Mode=OneWay}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding InstalledResourcePacks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:InstalledPackItem}">
                                                <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SizeText}" FontSize="8" Foreground="{StaticResource TextFaintBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Шейдеры: установленные -->
                                <StackPanel Visibility="{Binding IsShadersSubTab, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="УСТАНОВЛЕННЫЕ ШЕЙДЕРЫ" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8">
                                        <Run Text="Всего: "/><Run Text="{Binding InstalledShaders.Count, Mode=OneWay}"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding InstalledShaders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:InstalledPackItem}">
                                                <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SizeText}" FontSize="8" Foreground="{StaticResource TextFaintBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Сервера: последние -->
                                <StackPanel Visibility="{Binding IsServersSubTab, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="ПОСЛЕДНИЕ СЕРВЕРА" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="{Binding ActualHeight, ElementName=PagesHost, Converter={StaticResource Sub}, ConverterParameter=140}">
                                        <ItemsControl ItemsSource="{Binding RecentServers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ServerEntry}">
                                                    <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontSize="8" Foreground="{StaticResource TextFaintBrush}">
                                                                    <Run Text="{Binding Online, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Ping, Mode=OneWay}"/><Run Text="ms"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Играть" Style="{StaticResource BtnRed}"
                                                                    FontSize="9" Padding="8,3" VerticalAlignment="Center"
                                                                    Click="JoinServer_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== FRIENDS ===== -->
                        <Grid Margin="24,16,24,24" Visibility="{Binding FriendsActive, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая колонка -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Друзья" FontSize="20" FontWeight="Black" Margin="0,0,0,10"/>

                                    <!-- Баннер: чат заблокирован без подтверждённой личности -->
                                    <Border Background="#33B30000" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                            Visibility="{Binding CanUseFriendsChat, Converter={StaticResource InvBoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Чат друзей заблокирован" FontSize="12" FontWeight="Bold"
                                                       Foreground="White"/>
                                            <TextBlock Text="{Binding ChatLockReason}" FontSize="10"
                                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button Content="Войти через Discord" FontSize="10" Padding="10,5" Margin="0,8,0,0"
                                                    HorizontalAlignment="Left" Command="{Binding LoginDiscordCmd}"
                                                    IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvBool}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#5865F2"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Мой код + копировать -->
                                    <TextBlock Text="МОЙ КОД — дай его другу" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="#151515" CornerRadius="8" Padding="14,8"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MyFriendCode}" FontSize="20" FontWeight="Black"
                                                       Foreground="White" FontFamily="Consolas"/>
                                        </Border>
                                        <Button Content="Копировать" Style="{StaticResource BtnOutline}"
                                                FontSize="10" Padding="10,6" Margin="8,0,0,0"
                                                Command="{Binding CopyCodeCmd}"/>
                                    </StackPanel>

                                    <!-- Добавить друга (заявка) -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource WatermarkTextBox}" Tag="Код друга"
                                                 Text="{Binding FriendCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Добавить" Style="{StaticResource BtnRed}"
                                                FontSize="11" Padding="12,0" Margin="6,0,0,0"
                                                Command="{Binding AddFriendCmd}"/>
                                    </Grid>

                                    <!-- Мой статус -->
                                    <TextBox Style="{StaticResource WatermarkTextBox}" Tag="Мой статус (что видят друзья, пусто = авто)"
                                             Text="{Binding MyStatus, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                                    <!-- Тумблер звука -->
                                    <Grid Margin="0,0,0,10">
                                        <CheckBox Content="Звук" FontSize="10" VerticalAlignment="Center"
                                                  IsChecked="{Binding SoundEnabled}"/>
                                    </Grid>

                                    <!-- Заявки -->
                                    <StackPanel Visibility="{Binding HasFriendRequests, Converter={StaticResource BoolVis}}" Margin="0,0,0,10">
                                        <TextBlock Text="ЗАЯВКИ" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding FriendRequests}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FriendEntry}">
                                                    <Border Background="#22B30000" CornerRadius="6" Padding="8,6" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="✓" Style="{StaticResource IconBtn}"
                                                                    Width="22" Height="22" FontSize="11" Margin="0,0,4,0"
                                                                    Click="AcceptRequest_Click" Tag="{Binding}" ToolTip="Принять"/>
                                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource IconBtn}"
                                                                    Width="22" Height="22" FontSize="10"
                                                                    Click="DeclineRequest_Click" Tag="{Binding}" ToolTip="Отклонить"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Друзья -->
                                    <TextBlock Text="ДРУЗЬЯ" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource WatermarkTextBox}" Tag="Поиск друга..."
                                             Text="{Binding FriendSearch, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Height="28" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding FriendsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FriendEntry}">
                                                <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="8,6" Margin="0,2"
                                                        Cursor="Hand" MouseLeftButtonUp="FriendSelect_Click" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#7A7A7A"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                                    <Setter Property="Fill" Value="#2ECC71"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold"/>
                                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="5,0" Margin="6,0,0,0"
                                                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}">
                                                                    <TextBlock Text="{Binding UnreadBadge}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{StaticResource TextFaintBrush}"
                                                                       Margin="13,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="✎" Style="{StaticResource IconBtn}"
                                                                Width="20" Height="20" FontSize="10" VerticalAlignment="Center"
                                                                Click="RenameFriend_Click" Tag="{Binding}" ToolTip="Переименовать"/>
                                                        <Button Grid.Column="2" Content="➤" Style="{StaticResource IconBtn}"
                                                                Width="20" Height="20" FontSize="11" VerticalAlignment="Center"
                                                                Click="InviteFriend_Click" Tag="{Binding}" ToolTip="Позвать на свой сервер"/>
                                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource IconBtn}"
                                                                Width="20" Height="20" FontSize="9" VerticalAlignment="Center"
                                                                Click="RemoveFriend_Click" Tag="{Binding}" ToolTip="Удалить друга"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Группы -->
                                    <TextBlock Text="ГРУППЫ" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,12,0,4"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding GroupCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                                                 ToolTip="Код группы"/>
                                        <Button Grid.Column="1" Content="Войти" Style="{StaticResource BtnOutline}"
                                                FontSize="10" Padding="10,0" Margin="4,0,0,0"
                                                Command="{Binding JoinGroupCmd}"/>
                                        <Button Grid.Column="2" Content="Создать" Style="{StaticResource BtnRed}"
                                                FontSize="10" Padding="10,0" Margin="4,0,0,0"
                                                Command="{Binding CreateGroupCmd}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GroupChat}">
                                                <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="8,6" Margin="0,2"
                                                        Cursor="Hand" MouseLeftButtonUp="GroupSelect_Click" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold"/>
                                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="5,0" Margin="6,0,0,0"
                                                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}">
                                                                    <TextBlock Text="{Binding UnreadBadge}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock FontSize="9" Foreground="{StaticResource TextFaintBrush}">
                                                                <Run Text="Код: "/><Run Text="{Binding Code, Mode=OneWay}"/><Run Text="{Binding OnlineLabel, StringFormat=  · {0}, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource IconBtn}"
                                                                Width="20" Height="20" FontSize="9" VerticalAlignment="Center"
                                                                Click="LeaveGroup_Click" Tag="{Binding}" ToolTip="Выйти из группы"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    <!-- Участники выбранной группы -->
                                    <StackPanel Visibility="{Binding IsGroupChat, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="УЧАСТНИКИ" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,12,0,4"/>
                                        <ItemsControl ItemsSource="{Binding GroupMembers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GroupMember}">
                                                    <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="8,5" Margin="0,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#7A7A7A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                                <Setter Property="Fill" Value="#2ECC71"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Чат с другом -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"
                                    Visibility="{Binding IsFriendChat, Converter={StaticResource BoolVis}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{StaticResource BgHoverBrush}" Padding="14,10"
                                            CornerRadius="11,11,0,0"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                                <Run Text="Чат: "/><Run Text="{Binding SelectedFriend.DisplayName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="Сбросить чат" Style="{StaticResource BtnOutline}"
                                                    FontSize="10" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,0"
                                                    Command="{Binding ClearChatCmd}" ToolTip="Очистить историю переписки"/>
                                            <Button Grid.Column="2" Content="Присоединиться" Style="{StaticResource BtnRed}"
                                                    FontSize="10" Padding="12,5" VerticalAlignment="Center"
                                                    Visibility="{Binding SelectedFriend.CanJoin, Converter={StaticResource BoolVis}}"
                                                    Click="JoinFriend_Click"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
                                        <ItemsControl ItemsSource="{Binding ChatLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ChatLine}">
                                                    <StackPanel Margin="0,3">
                                                        <TextBlock FontSize="9" Foreground="{StaticResource TextFaintBrush}">
                                                            <Run Text="{Binding Sender, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TimeLabel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <!-- Обычное сообщение -->
                                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="10,6"
                                                                HorizontalAlignment="Left" MaxWidth="480"
                                                                Visibility="{Binding IsInvite, Converter={StaticResource InvBoolVis}}">
                                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"/>
                                                        </Border>
                                                        <!-- Карточка приглашения на сервер -->
                                                        <Border Background="#FF241A1A" BorderBrush="{DynamicResource AccentBrush}"
                                                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                                                HorizontalAlignment="Left" MaxWidth="420"
                                                                Visibility="{Binding IsInvite, Converter={StaticResource BoolVis}}">
                                                            <StackPanel>
                                                                <TextBlock Text="🎮 Приглашение на сервер" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{StaticResource AccentLightBrush}"/>
                                                                <TextBlock FontSize="13" FontWeight="Bold" Margin="0,4,0,0"
                                                                           Text="{Binding InviteServer, Mode=OneWay}"/>
                                                                <Button Content="Играть" Style="{StaticResource BtnRed}"
                                                                        FontSize="11" Padding="16,5" Margin="0,10,0,0"
                                                                        HorizontalAlignment="Left"
                                                                        Click="InvitePlay_Click" Tag="{Binding}"
                                                                        ToolTip="Подключиться к серверу"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Grid Grid.Row="2" Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding CanUseFriendsChat}"
                                                 KeyDown="ChatInput_KeyDown"/>
                                        <Button Grid.Column="1" Content="Отправить" Style="{StaticResource BtnRed}"
                                                FontSize="11" Padding="14,0" Margin="8,0,0,0"
                                                Command="{Binding SendChatCmd}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Групповой чат -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"
                                    Visibility="{Binding IsGroupChat, Converter={StaticResource BoolVis}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{StaticResource BgHoverBrush}" Padding="14,10"
                                            CornerRadius="11,11,0,0"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                                    <Run Text="Группа: "/><Run Text="{Binding SelectedGroup.DisplayName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock FontSize="9" Foreground="{StaticResource TextDimBrush}">
                                                        <Run Text="Код: "/><Run Text="{Binding SelectedGroup.Code, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Сбросить чат" Style="{StaticResource BtnOutline}"
                                                    FontSize="10" Padding="10,5" VerticalAlignment="Center"
                                                    Command="{Binding ClearChatCmd}" ToolTip="Очистить историю переписки"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10">
                                        <ItemsControl ItemsSource="{Binding GroupChatLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ChatLine}">
                                                    <StackPanel Margin="0,3">
                                                        <TextBlock FontSize="9" Foreground="{StaticResource TextFaintBrush}">
                                                            <Run Text="{Binding Sender, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TimeLabel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="6" Padding="10,6"
                                                                HorizontalAlignment="Left" MaxWidth="480">
                                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Grid Grid.Row="2" Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding GroupChatInput, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding CanUseFriendsChat}"
                                                 KeyDown="GroupChatInput_KeyDown"/>
                                        <Button Grid.Column="1" Content="Отправить" Style="{StaticResource BtnRed}"
                                                FontSize="11" Padding="14,0" Margin="8,0,0,0"
                                                Command="{Binding SendGroupChatCmd}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Пустой чат -->
                            <Border Grid.Column="2" Style="{StaticResource Card}"
                                    Visibility="{Binding IsNoChat, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Выберите друга или группу слева, чтобы начать общение" FontSize="13"
                                           Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                    <ScrollViewer x:Name="PageScroll2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsSecondaryPage, Converter={StaticResource BoolVis}}">
                        <Grid Margin="24,16,24,24">

                        <!-- ===== CONSOLE ===== -->
                        <Grid Visibility="{Binding ConsoleActive, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Логи Консоли" FontSize="20" FontWeight="Black"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Очистить" Style="{StaticResource BtnOutline}" Margin="0,0,8,0"
                                                FontSize="11" Command="{Binding ClearLogsCmd}"/>
                                        <Button Content="Диагностика" Style="{StaticResource BtnOutline}"
                                                FontSize="11" Click="Diagnostics_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Terminal -->
                                <Border Background="#09090B" CornerRadius="12"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Terminal header: three dots + title -->
                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="12,12,0,0"
                                                Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10" Fill="#FF5F57" Margin="0,0,6,0"/>
                                                    <Ellipse Width="10" Height="10" Fill="#FEBC2E" Margin="0,0,6,0"/>
                                                    <Ellipse Width="10" Height="10" Fill="#28C840"/>
                                                </StackPanel>
                                                <TextBlock Text="ded-launcher-bridge // terminal"
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource TextFaintBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Java Standard Out (UTF-8)"
                                                           FontFamily="Consolas" FontSize="9"
                                                           Foreground="{StaticResource TextFaintBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <!-- Log area -->
                                        <Border Padding="12" Height="360">
                                            <ListBox ItemsSource="{Binding ConsoleLines}" Background="Transparent"
                                                     BorderThickness="0" VirtualizingStackPanel.IsVirtualizing="True">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="10"
                                                                   Foreground="{StaticResource ConsoleGreenBrush}"
                                                                   Text="{Binding}" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                        <!-- Command input -->
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                            <Grid Margin="12,6">
                                                <TextBlock Text="&gt;&gt;" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding CmdInput, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="Consolas" FontSize="11" Padding="4,6" Margin="24,0,90,0"
                                                         Background="#09090B"/>
                                                <Button HorizontalAlignment="Right" Content="ОТПРАВИТЬ"
                                                        Style="{StaticResource BtnRed}" FontSize="10" Padding="12,6"
                                                        Command="{Binding SendCmdCmd}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ===== SCREENSHOTS ===== -->
                        <Grid Visibility="{Binding ScreenshotsActive, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Скриншоты" FontSize="20" FontWeight="Black" Margin="0,0,0,2"/>
                                        <TextBlock Text="Скриншоты, сделанные в Minecraft (F2)."
                                                   FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="📂 Открыть папку"
                                            Style="{StaticResource BtnOutline}" FontSize="11" Padding="12,6"
                                            VerticalAlignment="Center"
                                            Click="OpenScreenshotsFolder_Click"/>
                                </Grid>

                                <ScrollViewer x:Name="ScreenshotsScroll" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ScreenshotsScroll_PreviewMouseWheel"
                                              MaxHeight="{Binding ActualHeight, ElementName=PagesHost, Converter={StaticResource Sub}, ConverterParameter=120}">
                                    <ItemsControl ItemsSource="{Binding Screenshots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScreenshotItem}">
                                                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="8"
                                                        Cursor="Hand" MouseLeftButtonUp="Screenshot_Click" Tag="{Binding}">
                                                    <StackPanel>
                                                        <Border Background="{StaticResource BgInputBrush}" CornerRadius="6"
                                                                Height="110" ClipToBounds="True">
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                                                        </Border>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding FileName}" FontSize="10" Margin="0,0,0,2"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding TakenAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                                                           FontSize="9" Foreground="{StaticResource TextFaintBrush}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="📋" Style="{StaticResource IconBtn}"
                                                                    Width="26" Height="26" FontSize="12" Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Click="CopyScreenshot_Click" Tag="{Binding}"
                                                                    ToolTip="Скопировать в буфер обмена"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>

                        <!-- ===== SETTINGS ===== -->
                        <Grid Visibility="{Binding SetupActive, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая панель категорий -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
