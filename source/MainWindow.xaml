                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DlFile}" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <Border Grid.Column="1" Background="{StaticResource BgHoverBrush}" CornerRadius="8"
                                    Padding="10,3" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource WhiteBrush}"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               TextAlignment="Right" MinWidth="34">
                                        <Run Text="{Binding DlProgress, StringFormat={}{0:F0}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="%" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ProgressBar x:Name="ProgressMain" Value="{Binding DlProgress}" Maximum="100" Height="8"
                                     IsIndeterminate="{Binding DlIndeterminate}"/>
                        <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{StaticResource TextFaintBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Toast-уведомление -->
                <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,24" Background="{StaticResource BgCardBrush}"
                        CornerRadius="10" Padding="16,11"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ToastText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource WhiteBrush}"/>
                </Border>

                <!-- Оверлей drag & drop -->
                <Border x:Name="DropOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3" Visibility="Collapsed"
                        Background="#D90D0D10" IsHitTestVisible="False">
                    <Border Width="540" Height="190" Background="{StaticResource BgCardBrush}" CornerRadius="16"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⬇" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Бросьте файл для установки" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,10,0,6"/>
                            <TextBlock Text="Мод (.jar) · ресурспак/шейдер (.zip или папка) · скин (.png)"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Экран загрузки -->
                <Border Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{StaticResource BgDeepBrush}"
                        Visibility="{Binding IsInitializing, Converter={StaticResource BoolVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="DED Launcher" FontSize="26" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="{Binding InitStatus}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <Border Background="{StaticResource BgInputBrush}" CornerRadius="4" Height="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Border x:Name="loadBar" Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                        Width="60" HorizontalAlignment="Left" Margin="1">
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="loadBar"
                                                                     Storyboard.TargetProperty="(FrameworkElement.Width)"
                                                                     From="40" To="376" Duration="0:0:1.0" AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
